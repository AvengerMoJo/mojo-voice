MOJO_MCP_URL=http://127.0.0.1:8000/
MOJO_MCP_API_KEY=
MOJO_ROLE_ID=assistant
MOJO_VOICE_RUNTIME=mock
MOJO_MCP_MODE=search_memory
MOJO_STT_PROVIDER=funasr
MOJO_VOICE_API_HOST=0.0.0.0
MOJO_VOICE_API_PORT=9089

# Shared model caches (recommended to avoid re-downloading across tools)
# dotenv does not expand ~ — use absolute paths here
MODELSCOPE_CACHE=/home/alex/.cache/modelscope
HF_HOME=/home/alex/.cache/huggingface

# FunASR
FUNASR_MODEL=iic/SenseVoiceSmall
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_PUNC_MODEL=ct-punc
FUNASR_DEVICE=cpu
# FUNASR_DEVICE=cuda    ← use this for ROCm/CUDA GPU (ROCm exposes as cuda)

# Z.AI ASR (used when MOJO_STT_PROVIDER=zai_asr)
ZAI_API_KEY=
ZAI_ASR_MODEL=glm-asr-2512
ZAI_ASR_ENDPOINT=https://api.z.ai/api/paas/v4/audio/transcriptions
ZAI_ASR_TIMEOUT_SECONDS=30
ZAI_ASR_MAX_RETRIES=3
ZAI_ASR_RETRY_BASE_SECONDS=0.6
ZAI_ASR_RETRY_MAX_SECONDS=5.0
# Optional: at least 6 chars per API docs
ZAI_ASR_USER_ID=
# Optional comma-separated hotwords
ZAI_ASR_HOTWORDS=

# CosyVoice (v3 recommended)
COSYVOICE_MODEL_PATH=pretrained_models/Fun-CosyVoice3-0.5B
COSYVOICE_SPEAKER=
# CosyVoice3 zero-shot: path to reference WAV (defaults to .vendor/CosyVoice/asset/zero_shot_prompt.wav)
COSYVOICE_PROMPT_WAV=
# CosyVoice3 instruct prefix for zero-shot synthesis
COSYVOICE_INSTRUCT_TEXT=

# Backward-compat keys (optional)
COSYVOICE2_MODEL_PATH=
COSYVOICE2_SPEAKER=
